rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPaciente(data, pacienteId) {
      let requiredKeys = [
        'id', 'codigo', 'identificacionPaciente', 'fechaCreacion',
        'faseActual', 'estado', 'fase1Completada', 'fase2Completada', 'fase3Completada',
        'criteriosTamizaje', 'puntajeTamizaje', 'categoriaTriage', 'categoriaTriageLabel',
        'diagnosticoTriage', 'tiempoFase1Segundos', 'tiempoFase2Segundos',
        'tiempoFase3Segundos', 'tiempoTotalSegundos', 'timestampInicio'
      ];
      let allowedKeys = [
        'id', 'codigo', 'identificacionPaciente', 'nombre', 'apellido', 'edadAnos', 'edadMeses',
        'vitalesIngreso', 'fechaCreacion',
        'faseActual', 'estado', 'fase1Completada', 'fase2Completada', 'fase3Completada',
        'criteriosTamizaje', 'puntajeTamizaje', 'categoriaTriage', 'categoriaTriageLabel',
        'diagnosticoTriage', 'autorTriage', 'diagnosticoUrgencias', 'aplicaSepsis',
        'aprobadoUrgencias', 'motivoDescarte', 'autorUrgencias', 'diagnosticoDetecto',
        'autorDetecto', 'tiempoFase1Segundos', 'tiempoFase2Segundos',
        'tiempoFase3Segundos', 'tiempoTotalSegundos', 'timestampInicio',
        'timestampPasoFase2', 'timestampPasoFase3', 'timestampFinalizado',
        'categoriaTriageValidada', 'categoriaTriageValidadaLabel', 'motivoCambioCategoria',
        'reportadoADetecto', 'habilitadoCierreAnticipado', 'motivoCierreAnticipado',
        'estadosModulos', 'tiemposSubmodulos', 'formularioEquipoSepsis',
        'laboratorios', 'anexo2Data', 'anexo3Data', 'anexo4Data', 'vasopresoresData',
        'enPapelera', 'fechaEliminacion'
      ];

      return data.keys().hasAll(requiredKeys) &&
        data.keys().hasOnly(allowedKeys) &&
        isValidId(data.id) &&
        data.id == pacienteId &&
        data.codigo is string && data.codigo.size() >= 4 && data.codigo.size() <= 64 &&
        data.identificacionPaciente is string && data.identificacionPaciente.size() <= 128 &&
        (data.fechaCreacion is int || data.fechaCreacion is float) &&
        data.faseActual in [1, 2, 3, 4] &&
        data.estado in ['en_triage', 'pendiente_urgencias', 'pendiente_detecto', 'completado', 'descartado'] &&
        data.fase1Completada is bool &&
        data.fase2Completada is bool &&
        data.fase3Completada is bool &&
        data.criteriosTamizaje is list && data.criteriosTamizaje.size() == 8 && data.criteriosTamizaje[0] is bool &&
        (data.puntajeTamizaje is int || data.puntajeTamizaje is float) &&
        data.puntajeTamizaje >= 0 && data.puntajeTamizaje <= 8 &&
        data.categoriaTriage in [1, 2, 3] &&
        data.categoriaTriageLabel is string && data.categoriaTriageLabel.size() <= 200 &&
        data.diagnosticoTriage is string && data.diagnosticoTriage.size() <= 4000 &&
        (data.tiempoFase1Segundos is int || data.tiempoFase1Segundos is float) && data.tiempoFase1Segundos >= 0 &&
        (data.tiempoFase2Segundos is int || data.tiempoFase2Segundos is float) && data.tiempoFase2Segundos >= 0 &&
        (data.tiempoFase3Segundos is int || data.tiempoFase3Segundos is float) && data.tiempoFase3Segundos >= 0 &&
        (data.tiempoTotalSegundos is int || data.tiempoTotalSegundos is float) && data.tiempoTotalSegundos >= 0 &&
        (data.timestampInicio is int || data.timestampInicio is float) &&
        (!('nombre' in data) || (data.nombre is string && data.nombre.size() <= 200)) &&
        (!('apellido' in data) || (data.apellido is string && data.apellido.size() <= 200)) &&
        (!('edadAnos' in data) || (data.edadAnos is string && data.edadAnos.size() <= 32)) &&
        (!('edadMeses' in data) || (data.edadMeses is string && data.edadMeses.size() <= 32)) &&
        (!('vitalesIngreso' in data) || data.vitalesIngreso is map) &&
        (!('autorTriage' in data) || (data.autorTriage is string && data.autorTriage.size() <= 200)) &&
        (!('diagnosticoUrgencias' in data) || (data.diagnosticoUrgencias is string && data.diagnosticoUrgencias.size() <= 4000)) &&
        (!('aplicaSepsis' in data) || data.aplicaSepsis is bool) &&
        (!('aprobadoUrgencias' in data) || data.aprobadoUrgencias is bool) &&
        (!('motivoDescarte' in data) || (data.motivoDescarte is string && data.motivoDescarte.size() <= 2000)) &&
        (!('autorUrgencias' in data) || (data.autorUrgencias is string && data.autorUrgencias.size() <= 200)) &&
        (!('diagnosticoDetecto' in data) || (data.diagnosticoDetecto is string && data.diagnosticoDetecto.size() <= 4000)) &&
        (!('autorDetecto' in data) || (data.autorDetecto is string && data.autorDetecto.size() <= 200)) &&
        (!('timestampPasoFase2' in data) || (data.timestampPasoFase2 is int || data.timestampPasoFase2 is float)) &&
        (!('timestampPasoFase3' in data) || (data.timestampPasoFase3 is int || data.timestampPasoFase3 is float)) &&
        (!('timestampFinalizado' in data) || (data.timestampFinalizado is int || data.timestampFinalizado is float)) &&
        (!('categoriaTriageValidada' in data) || data.categoriaTriageValidada in [1, 2, 3]) &&
        (!('categoriaTriageValidadaLabel' in data) || (data.categoriaTriageValidadaLabel is string && data.categoriaTriageValidadaLabel.size() <= 200)) &&
        (!('motivoCambioCategoria' in data) || (data.motivoCambioCategoria is string && data.motivoCambioCategoria.size() <= 2000)) &&
        (!('reportadoADetecto' in data) || data.reportadoADetecto is bool) &&
        (!('habilitadoCierreAnticipado' in data) || data.habilitadoCierreAnticipado is bool) &&
        (!('motivoCierreAnticipado' in data) || (data.motivoCierreAnticipado is string && data.motivoCierreAnticipado.size() <= 2000)) &&
        (!('estadosModulos' in data) || data.estadosModulos is map) &&
        (!('tiemposSubmodulos' in data) || data.tiemposSubmodulos is map) &&
        (!('formularioEquipoSepsis' in data) || data.formularioEquipoSepsis is map) &&
        (!('laboratorios' in data) || data.laboratorios is map) &&
        (!('anexo2Data' in data) || data.anexo2Data is map) &&
        (!('anexo3Data' in data) || data.anexo3Data is map) &&
        (!('anexo4Data' in data) || data.anexo4Data is map) &&
        (!('vasopresoresData' in data) || data.vasopresoresData is map) &&
        (!('enPapelera' in data) || data.enPapelera is bool) &&
        (!('fechaEliminacion' in data) || (data.fechaEliminacion is int || data.fechaEliminacion is float));
    }

    match /pacientes/{pacienteId} {
      allow get: if isValidId(pacienteId);
      allow list: if resource.data.estado in ['en_triage', 'pendiente_urgencias', 'pendiente_detecto', 'completado', 'descartado'];

      allow create: if isValidId(pacienteId) && isValidPaciente(incoming(), pacienteId);

      allow update: if isValidId(pacienteId) &&
        isValidPaciente(incoming(), pacienteId) &&
        incoming().id == existing().id &&
        incoming().codigo == existing().codigo &&
        incoming().fechaCreacion == existing().fechaCreacion &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'identificacionPaciente', 'nombre', 'apellido', 'edadAnos', 'edadMeses', 'vitalesIngreso',
          'faseActual', 'estado', 'fase1Completada', 'fase2Completada', 'fase3Completada',
          'criteriosTamizaje', 'puntajeTamizaje', 'categoriaTriage', 'categoriaTriageLabel',
          'diagnosticoTriage', 'autorTriage', 'diagnosticoUrgencias', 'aplicaSepsis',
          'aprobadoUrgencias', 'motivoDescarte', 'autorUrgencias', 'diagnosticoDetecto',
          'autorDetecto', 'tiempoFase1Segundos', 'tiempoFase2Segundos',
          'tiempoFase3Segundos', 'tiempoTotalSegundos', 'timestampInicio',
          'timestampPasoFase2', 'timestampPasoFase3', 'timestampFinalizado',
          'categoriaTriageValidada', 'categoriaTriageValidadaLabel', 'motivoCambioCategoria',
          'reportadoADetecto', 'habilitadoCierreAnticipado', 'motivoCierreAnticipado',
          'estadosModulos', 'tiemposSubmodulos', 'formularioEquipoSepsis',
          'laboratorios', 'anexo2Data', 'anexo3Data', 'anexo4Data', 'vasopresoresData',
          'enPapelera', 'fechaEliminacion'
        ]);

      allow delete: if isValidId(pacienteId) && existing().enPapelera == true;
    }

    match /counters/{counterId} {
      allow get: if counterId == 'pacientes_seq';
      allow create: if counterId == 'pacientes_seq' &&
        incoming().keys().hasAll(['lastSeq']) &&
        incoming().keys().hasOnly(['lastSeq']) &&
        incoming().lastSeq is int &&
        incoming().lastSeq >= 1 &&
        incoming().lastSeq <= 999999;
      allow update: if counterId == 'pacientes_seq' &&
        incoming().keys().hasAll(['lastSeq']) &&
        incoming().keys().hasOnly(['lastSeq']) &&
        incoming().lastSeq is int &&
        incoming().lastSeq >= existing().lastSeq &&
        incoming().lastSeq <= 999999;
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
    }
  }
}
